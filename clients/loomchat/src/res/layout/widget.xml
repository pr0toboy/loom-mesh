<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_bg">
  <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#E8EAF0" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#9AA1AD" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp"/>
  <TextView android:id="@+id/w_quota" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#9AA1AD" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="6dp"/>
</LinearLayout>
